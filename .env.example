# Copy to .env and fill in (never commit .env). Mock mode needs neither key.

# Exa (web research). Free key, no card: https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# Gemini (the AI that plans, judges and writes). Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# PLANNER_MODEL=gemini-3.6-flash         # judgment steps
# RESEARCHER_MODEL=gemini-3.5-flash-lite # runs once or twice per question
# GEMINI_RPM=10                          # AI calls per minute (free-tier friendly)

# Or Claude through OpenCode's pay-as-you-go gateway:
# AI_PROVIDER=opencode
# OPENCODE_API_KEY=
# OPENCODE_BASE_URL=https://opencode.ai/inference/anthropic

# Phoenix (local, no key). Set PHOENIX_TRACING=0 to turn tracing off.
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=competitor-agent
# PHOENIX_URL=http://localhost:6006
