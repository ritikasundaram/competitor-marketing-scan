# Copy to .env and fill in (never commit .env)
# Free Exa key (no card): https://dashboard.exa.ai/api-keys ($20 signup + $10/mo)
EXA_API_KEY=
# Phoenix local (defaults work, no key needed):
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=marketing-agent
# Optional Langfuse (cloud default; set LANGFUSE_OTEL_ENDPOINT for self-host):
# LANGFUSE_OTEL_ENDPOINT=https://cloud.langfuse.com/api/public/otel
# LANGFUSE_SECRET_KEY=
# LANGFUSE_PUBLIC_KEY=
# Optional OpenAI synthesis (default template = $0; auto uses OpenAI when this is set):
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
