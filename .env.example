# Copy to .env and fill in (never commit .env). Mock mode needs neither key.

# Exa (web research). Free key, no card: https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# The AI that plans, judges and writes. Set ONE of these (Anthropic wins if both are set).
# Claude Haiku 5.5 via the Anthropic API: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Or Gemini. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# PLANNER_MODEL=claude-haiku-5-5        # judgment steps (comma-separate to give fallbacks)
# RESEARCHER_MODEL=claude-haiku-5-5     # runs once or twice per question
# GEMINI_RPM=10                         # Gemini only: AI calls per minute (free-tier friendly)

# Or Claude through OpenCode's pay-as-you-go gateway:
# AI_PROVIDER=opencode
# OPENCODE_API_KEY=
# OPENCODE_BASE_URL=https://opencode.ai/inference/anthropic

# Phoenix (local, no key). Set PHOENIX_TRACING=0 to turn tracing off.
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=competitor-agent
# PHOENIX_URL=http://localhost:6006
