{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp?exaApiKey={env:EXA_API_KEY}&tools=web_search_advanced_exa,competitor_finder,company_research,web_fetch_exa",
      "enabled": true
    }
  },
  "agent": {
    "marketing-researcher": {
      "description": "Researches competitor marketing campaigns and effectiveness via Exa",
      "mode": "subagent"
    }
  }
}
